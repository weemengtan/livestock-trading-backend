# Copy to .env for local dev. Never commit the real .env.

DATABASE_URL=postgresql+asyncpg://livestock:livestock@localhost:5432/livestock
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_TTL_DAYS_BUYER=90

INVITE_TTL_HOURS=72

LOGIN_RATE_LIMIT_PER_MINUTE=5

# Set to true in CI/tests to skip the live HIBP network call
DISABLE_BREACHED_PASSWORD_CHECK=false

# false for local dev/CI (no TLS) so the refresh cookie is actually sent
# back; true in every real deployment (Vercel/Railway, both HTTPS-only).
COOKIE_SECURE=false

# false while still in dev/test/demo so OWNER/ACCOUNTANT logins skip
# entering a TOTP code every time. Defaults to true in code (§14) — set
# this back to true (or delete the line) before a real deployment.
MFA_ENFORCEMENT_ENABLED=false

# Comma-separated exact origins allowed to call this API with credentials
# (the refresh cookie). Add the real Vercel URL here once one exists.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web Push (§10). Generate with: uv run python -m scripts.generate_vapid_keys
# Left blank, push sends are skipped (logged, not raised) — WS + polling
# still deliver, so this is safe to leave empty in local dev.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

# §14 general/buyer-sync rate limits (core/rate_limit_middleware.py) —
# usually fine at these defaults, override only for load testing.
GENERAL_RATE_LIMIT_PER_MINUTE=100
BUYER_SYNC_RATE_LIMIT_PER_MINUTE=1000

# §16 — Sentry (main.py). Left blank, sentry_sdk.init is never even called.
# In production, point this at a self-hosted, FOSS-licensed target only
# (self-hosted Sentry, or GlitchTip) — never sentry.io.
SENTRY_DSN=
