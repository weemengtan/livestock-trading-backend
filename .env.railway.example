# Copy to .env.railway (git-ignored) — used ONLY by scripts/cloud.sh to run
# the reset/seed scripts from your laptop against the Railway TEST database.
# It is not read by the deployed service (that gets its variables in the
# Railway dashboard — see DEPLOY.md).

# Postgres service -> Variables -> DATABASE_PUBLIC_URL (the TCP-proxy URL;
# the internal *.railway.internal URL is not reachable from your laptop).
# Pasting it as-is is fine: postgresql:// is converted to +asyncpg for you.
DATABASE_URL=

# Required by scripts/wipe_business_data.py, which refuses to run otherwise.
# This file is your explicit statement "this database is disposable test data".
# Delete .env.railway (or don't use cloud.sh) once real data lives there.
ENVIRONMENT=dev

# Password given to bobby/bing/buyer@example.com by `cloud.sh seed`. The
# default is public and this database is on the internet — set your own.
SEED_PASSWORD=
